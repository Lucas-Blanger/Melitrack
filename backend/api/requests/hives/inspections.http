@baseUrl = http://localhost:8000

@email = lucas2@email.com
@password = 12345678

###

# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

###

@accessToken = {{login.response.body.access_token}}

# IDs existentes
@hiveId = {{createHive.response.body.id}}


# Criar colmeia
# @name createHive
POST {{baseUrl}}/hives
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Colmeia 01",
  "type": "caixa",
  "species": "Apis mellifera",
  "latitude": -27.634,
  "longitude": -52.273,
  "installation_date": "2026-07-06",
  "is_active": true,
  "notes": "Colmeia próxima ao pomar."
}


###

# Criar inspeção
# @name createInspection
POST {{baseUrl}}/inspections
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "hive_id": "{{hiveId}}",
  "health": "boa",
  "queen_seen": true,
  "honey_level": 8,
  "population_estimate": "Alta",
  "notes": "Colônia saudável.",
  "inspected_at": "2026-07-07T15:00:00Z"
}

###

@inspectionId = {{createInspection.response.body.id}}

###

# Listar inspeções da colmeia
GET {{baseUrl}}/inspections/hive/{{hiveId}}
Authorization: Bearer {{accessToken}}

###

# Buscar inspeção por ID
GET {{baseUrl}}/inspections/{{inspectionId}}
Authorization: Bearer {{accessToken}}

###

# Upload de foto da inspeção
POST {{baseUrl}}/inspections/{{inspectionId}}/photos
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="photo.jpg"
Content-Type: image/jpeg

< .photos/photo.jpg
--boundary--

###

# Buscar análise da inspeção
GET {{baseUrl}}/inspections/{{inspectionId}}/analysis
Authorization: Bearer {{accessToken}}

###

# Atualizar análise da inspeção (usuário autenticado)
PATCH {{baseUrl}}/inspections/{{inspectionId}}/analysis
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "status": "processed",
  "model_name": "EfficientNetB0-v1",
  "result": {
    "population": {
      "density_score": 0.84
    },
    "anomaly": {
      "scores": {
        "queen": 0.05,
        "disease": 0.02,
        "stress": 0.10
      }
    }
  },
  "confidence": 0.84,
  "processed_at": "2026-07-07T16:00:00Z"
}

###

@mlToken = {{$dotenv %ML_TOKEN%}}

# Atualizar análise da inspeção (serviço interno de ML)
PATCH {{baseUrl}}/inspections/{{inspectionId}}/analysis
X-ML-Service-Token: {{mlToken}}
Content-Type: application/json

{
  "status": "processed",
  "model_name": "EfficientNetB0-v1",
  "result": {
    "population": {
      "density_score": 0.82
    },
    "anomaly": {
      "scores": {
        "queen": 0.08,
        "disease": 0.03,
        "stress": 0.12
      }
    }
  },
  "confidence": 0.82,
  "processed_at": "2026-07-07T16:05:00Z"
}

###

# Corrigir análise da inspeção
PATCH {{baseUrl}}/inspections/{{inspectionId}}/analysis/correction
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "corrected_result": {
    "population": {
      "density_score": 0.88
    },
    "anomaly": {
      "scores": {
        "queen": 0.04,
        "disease": 0.01,
        "stress": 0.07
      }
    }
  },
  "correction_notes": "Correção manual após revisão da foto."
}