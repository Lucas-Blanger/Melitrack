# Database configuration
DATABASE_URL=
# API configuration
API_PORT=8000
DEBUG=True
COOKIE_SECURE=false
ALGORITHM=HS256
APP_NAME=Melitrack API
APP_VERSION=1.0.0
ALLOWED_ORIGINS=["http://localhost:3000"]

# Email config
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

SMTP_USERNAME=youremail@gmail.com
SMTP_PASSWORD=your_password

SMTP_FROM=youremail@gmail.com


# Security
SECRET_KEY=your-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Photos database
MONGO_DB=melitrack_photo
MONGO_URL=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority


# Rate limit
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT_REQUESTS=300
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_LOGIN_REQUESTS=5
RATE_LIMIT_AUTH_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REGISTER_REQUESTS=10
RATE_LIMIT_AUTH_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_AUTH_PASSWORD_RESET_REQUESTS=3
RATE_LIMIT_AUTH_PASSWORD_RESET_WINDOW_SECONDS=900
