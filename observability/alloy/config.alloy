local.file_match "melitrack_logs" {
  path_targets = [
    {
      __path__ = "/var/log/melitrack/api.log",
      job      = "melitrack-api",
      service  = "api",
      app      = "melitrack",
    },
    {
      __path__ = "/var/log/melitrack/ml.log",
      job      = "melitrack-ml",
      service  = "ml",
      app      = "melitrack",
    },
    {
      __path__ = "/var/log/melitrack/ml-worker.log",
      job      = "melitrack-ml-worker",
      service  = "ml-worker",
      app      = "melitrack",
    },
  ]
}

loki.source.file "melitrack_scrape" {
  targets    = local.file_match.melitrack_logs.targets
  forward_to = [loki.write.endpoint.receiver]
}

loki.write "endpoint" {
  endpoint {
    url = "http://melitrack-loki:3100/loki/api/v1/push"
  }
}